# Copia este archivo como .env y ajusta los valores.
# Genera un secreto con: openssl rand -hex 32
JWT_SECRET=
NODE_ENV=production
PORT=3001
# false: empezar sin las 4 mascotas de demostración (solo afecta al primer arranque)
SEED_DEMO=true
# true permite que cualquiera cree una cuenta desde la pantalla de login
ALLOW_REGISTRATION=false
# true si hay un proxy/nginx delante (necesario para cookies Secure con HTTPS)
TRUST_PROXY=false
# Intentos fallidos de login permitidos por IP cada 15 minutos (0 desactiva el límite)
LOGIN_RATE_LIMIT=10
# Copias automáticas de la base en data/backups (0 desactiva)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
# Zona horaria del servidor (afecta a la fecha "de hoy" por defecto)
TZ=America/Bogota
